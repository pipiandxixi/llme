{
  "buildCommand": "npm run build:web",
  "outputDirectory": "app/web/dist",
  "framework": null,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "profiles/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
